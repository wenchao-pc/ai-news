# ===== ai-news 配置模板 =====
# 复制为 .env 并按实际情况填写

# 代理（留空 = 直连，不启用代理降级）
# 支持 socks5h://host:port 或 http://host:port
PROXY_URL=socks5h://127.0.0.1:7890

# 飞书资源 token（替换为你的实际值）
LARK_ROOT_FOLDER=your_root_folder_token
LARK_INDEX_DOC=your_index_doc_token
LARK_HR_BLOCK_ID=your_hr_block_id

# 飞书域名（构造文件查看链接用）
FEISHU_DOMAIN=your_tenant.feishu.cn

# 发布身份: bot = 应用身份（免登录，需 app 有应用身份 scope 且资源已共享给该 app）
#           user = 用户身份（走 lark-cli auth login，token 约 7 天需续登）
#           auto = lark-cli 自动选择
LARK_AS=bot
# 发布 app 的 app_id（用于资源授权: lark-cli drive +member-add --member-type appid
# --member-id <LARK_APP_ID> --perm edit --token <文件夹/文档token>）
LARK_APP_ID=your_app_id

# 采集源开关（逗号分隔；未设置 = 全部启用）
# 可用源: github_trending hacker_news huggingface_trending
#          reddit_local_llama reddit_machinelearning producthunt_ai techmeme
# 组别名: reddit = reddit_local_llama + reddit_machinelearning
# 示例:
#   SOURCES=all,-reddit              # 全部启用但禁用 Reddit
#   SOURCES=github_trending,huggingface_trending   # 只采 GitHub + HF
#   SOURCES=all,-techmeme,-producthunt_ai          # 全部启用但禁用商业类
SOURCES=github_trending,huggingface_trending
